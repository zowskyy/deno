#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG="/usr/local/bin/gateway-probe-serve"
CONFIG="/etc/config/gateway-probe"
DB="/overlay/gateway-probe/reports.db"

config_load gateway_probe

start_service() {
    mkdir -p /overlay/gateway-probe

    local bind_address port
    config_get bind_address "gateway_probe" "bind_address" "127.0.0.1"
    config_get port "gateway_probe" "port" "8734"

    procd_open_instance
    procd_set_param command "$PROG" \
        --store "$DB" \
        --host "$bind_address" \
        --port "$port"

    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "gateway-probe"
}
