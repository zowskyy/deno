#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=09

PROG="/usr/libexec/gateway-probe/controller-daemon"
STORE="/overlay/gateway-probe/reports.db"

start_service() {
    mkdir -p /overlay/gateway-probe

    procd_open_instance "gateway_probe_control"
    procd_set_param command "$PROG" \
        --store "$STORE" \
        --interval-seconds 60 \
        --mode observe_only

    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile="256 256"
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "gateway-probe"
}
